# Copy to .env.local (gitignored). Never commit credentials.

# sqlite = demo with sample data, needs no DB or network. mysql = the lab's database.
CEDIVEP_DRIVER=sqlite

# Shows the login code on screen instead of sending it. Default: on with sqlite, off with mysql.
# Refused with mysql in production. NEVER turn it on with the portal exposed to the internet.
# CEDIVEP_DEMO=1

# Lab database (only with CEDIVEP_DRIVER=mysql). Use the read-only user (sql/usuario_solo_lectura.sql).
DB_HOST=190.128.170.42
DB_PORT=3309
DB_USER=portal_ro
DB_PASSWORD=
DB_NAME=cedivep

# Session cookie signing key. Required with mysql (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# Public origin used in shared links (WhatsApp).
PUBLIC_URL=http://localhost:3000

# In production, behind HTTPS (Cloudflare Tunnel):
COOKIE_SECURE=false
TRUST_PROXY=false

# Business policy, to confirm with the lab (HANDOFF.md §10).
BLOCK_DELINQUENT=false
BLOCK_DISABLED=true
